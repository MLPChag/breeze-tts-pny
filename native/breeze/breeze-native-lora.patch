+#include "breeze/model.h"
+#include "breeze/scheduler.h"
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <chrono>
+#include <stdexcept>
+using namespace breeze;
+static void require(bool ok, const char * msg) { if (!ok) throw std::runtime_error(msg); }
+static void adapter_file(const std::string & path, float alpha, int version = 1, bool missing = false) {
+    auto * ctx = ggml_init({ggml_tensor_overhead()*4, nullptr, false});
+    auto * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 32, 2);
+    auto * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2, 32);
+    ggml_set_name(a, "bb.lm_head.weight.lora_a"); ggml_set_name(b, "bb.lm_head.weight.lora_b");
+    for (int i=0;i<64;i++) { ((float *)a->data)[i] = (i%7-3)*0.03f; ((float *)b->data)[i] = (i%5-2)*0.04f; }
+    auto * out = gguf_init_empty();
+    gguf_set_val_str(out,"general.architecture","breeze-tts-2");
+    gguf_set_val_str(out,"general.type","adapter"); gguf_set_val_str(out,"adapter.type","lora");
+    gguf_set_val_u32(out,"breeze.lora.version",version); gguf_set_val_u32(out,"breeze.lora.rank",2);
+    gguf_set_val_f32(out,"adapter.lora.alpha",alpha);
+    gguf_add_tensor(out,a); if (!missing) gguf_add_tensor(out,b);
+    require(gguf_write_to_file(out,path.c_str(),false),"write adapter fixture");
+    gguf_free(out); ggml_free(ctx);
+}
+static std::vector<float> project(BreezeModel & m, const std::string & id) {
+    m.select_lora(id);
+    Graph g(64);
+    std::vector<float> input(32); for (int i=0;i<32;i++) input[i]=(i%9-4)*0.1f;
+    auto * x=g.input_f32(input,32);
+    auto * y=m.project(g.ctx,"bb.lm_head.weight",x); g.compute(m.backend,y);
+    return tensor_to_f32(y);
+}
+static void close(const std::vector<float> & a,const std::vector<float> & b,float eps=1e-5f) {
+    require(a.size()==b.size(),"wrong shape");
+    for(size_t i=0;i<a.size();i++) require(std::isfinite(a[i]) && std::abs(a[i]-b[i])<=eps,"LoRA math or restoration mismatch");
+}
+int main(int argc,char ** argv) {
+    const bool gpu=argc>1 && std::string(argv[1])=="--gpu";
+    BreezeModel m; m.backend.init(gpu);
+    if(gpu && !m.backend.is_gpu) { m.free();return 77; }
+    auto dir=std::filesystem::temp_directory_path()/("breeze-lora-test-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    std::filesystem::create_directory(dir);
+    try {
+        m.gg.meta=ggml_init({ggml_tensor_overhead()*4,nullptr,true});
+        auto * w=ggml_new_tensor_2d(m.gg.meta,GGML_TYPE_F32,32,32);
+        m.gg.tensors["bb.lm_head.weight"]=w;
+        m.gg.buffer=ggml_backend_alloc_ctx_tensors(m.gg.meta,m.backend.backend);
+        std::vector<float> weights(1024);for(int i=0;i<1024;i++)weights[i]=(i%11-5)*0.02f;
+        ggml_backend_tensor_set(w,weights.data(),0,weights.size()*sizeof(float));
+        adapter_file((dir/"a.gguf").string(),4);adapter_file((dir/"b.gguf").string(),8);
+        m.load_lora("a",(dir/"a.gguf").string());m.load_lora("b",(dir/"b.gguf").string());
+        const auto base=project(m,"");std::vector<float> expected=base;
+        float ax[2]={};
+        for(int r=0;r<2;r++)for(int i=0;i<32;i++)ax[r]+=((r*32+i)%7-3)*0.03f*(i%9-4)*0.1f;
+        for(int o=0;o<32;o++)for(int r=0;r<2;r++)expected[o]+=2*((o*2+r)%5-2)*0.04f*ax[r];
+        for(int i=0;i<5;i++) {
+            close(project(m,"a"),expected);
+            auto twice=base;for(int o=0;o<32;o++)twice[o]+=2*(expected[o]-base[o]);
+            close(project(m,"b"),twice);close(project(m,""),base,0);
+        }
+        std::vector<float> after(1024);ggml_backend_tensor_get(w,after.data(),0,after.size()*sizeof(float));
+        close(after,weights,0);
+        bool rejected=false;try{m.select_lora("missing");}catch(const std::runtime_error &){rejected=true;}
+        require(rejected,"unknown id accepted");
+        rejected=false;try{GenScheduler sched;sched.start(m,2);}catch(const std::runtime_error &){rejected=true;}
+        require(rejected,"concurrent adapters accepted");
+        for(int kind=0;kind<3;kind++) {
+            adapter_file((dir/"bad.gguf").string(),kind==2?NAN:4,kind==0?9:1,kind==1);
+            rejected=false;try{m.load_lora("bad",(dir/"bad.gguf").string());}catch(const std::runtime_error &){rejected=true;}
+            require(rejected,"invalid adapter accepted");require(!m.has_lora("bad"),"failed load leaked registry entry");
+        }
+        m.free();std::filesystem::remove_all(dir);printf("LoRA numerical, selection, base-restoration and rejection checks passed\n");return 0;
+    }catch(const std::exception & e){fprintf(stderr,"%s\n",e.what());m.free();std::filesystem::remove_all(dir);return 1;}
+}
