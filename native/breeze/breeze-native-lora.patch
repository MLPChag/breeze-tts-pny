+#pragma once
+#include "breeze/gguf_loader.h"
+#include <map>
+#include <string>
+namespace breeze {
+struct LoRAPair { ggml_tensor * a; ggml_tensor * b; float scale; };
+// Immutable after loading; tensors stay separate from the base weights.
+struct LoRAAdapter {
+    GGUFModel gg;
+    std::map<std::string, LoRAPair> pairs;
+    ~LoRAAdapter() { gg.free(); }
+    void load(const std::string & path, Backend & backend, const GGUFModel & base);
+};
+}
diff --git a/src/lora.cpp b/src/lora.cpp
new file mode 100644
index 0000000..48a6621
--- /dev/null
+++ b/src/lora.cpp
@@ -0,0 +1,44 @@
+#include "breeze/lora.h"
+#include <cmath>
+#include <regex>
+#include <stdexcept>
+namespace breeze {
+void LoRAAdapter::load(const std::string & path, Backend & backend, const GGUFModel & base) {
+    if (gg.gguf) throw std::runtime_error("adapter already loaded");
+    if (!gg.load(path, backend)) throw std::runtime_error("cannot load adapter: " + path);
+    if (gg.kv_str("general.architecture") != "breeze-tts-2" ||
+        gg.kv_str("general.type") != "adapter" || gg.kv_str("adapter.type") != "lora" ||
+        gg.kv_u32("breeze.lora.version") != 1) throw std::runtime_error("unsupported Breeze LoRA format");
+    const int rank = gg.kv_u32("breeze.lora.rank");
+    const float alpha = gg.kv_f32("adapter.lora.alpha");
+    if (rank <= 0 || rank > 1024 || !std::isfinite(alpha) || alpha <= 0)
+        throw std::runtime_error("invalid LoRA rank or alpha");
+    const std::regex target(R"((bb|dd)\.blk\.[0-9]+\.(attn_q|attn_k|attn_v|attn_output|ffn_gate|ffn_up|ffn_down)\.weight|te\.proj\.weight|dd\.in_proj\.weight|bb\.lm_head\.weight)");
+    for (const auto & entry : gg.tensors) {
+        const std::string & name = entry.first;
+        if (name.size() < 8 || (name.substr(name.size()-7) != ".lora_a" && name.substr(name.size()-7) != ".lora_b"))
+            throw std::runtime_error("unexpected adapter tensor: " + name);
+        const std::string weight = name.substr(0, name.size()-7);
+        if (!std::regex_match(weight, target)) throw std::runtime_error("unsupported adapter target: " + weight);
+        ggml_tensor * w = base.find(weight);
+        ggml_tensor * a = gg.find(weight + ".lora_a"), * b = gg.find(weight + ".lora_b");
+        if (!w || !a || !b || w->ne[2] != 1 || w->ne[3] != 1 ||
+            a->ne[0] != w->ne[0] || a->ne[1] != rank || b->ne[0] != rank || b->ne[1] != w->ne[1] ||
+            a->ne[2] != 1 || a->ne[3] != 1 || b->ne[2] != 1 || b->ne[3] != 1)
+            throw std::runtime_error("LoRA pair missing or incompatible with base: " + weight);
+        auto * t = entry.second;
+        if (t->type != GGML_TYPE_F32 && t->type != GGML_TYPE_F16) throw std::runtime_error("LoRA tensors must be F16 or F32");
+        const size_t n = ggml_nelements(t);
+        std::vector<float> values(n);
+        if (t->type == GGML_TYPE_F32) ggml_backend_tensor_get(t, values.data(), 0, n*sizeof(float));
+        else {
+            std::vector<ggml_fp16_t> half(n);
+            ggml_backend_tensor_get(t, half.data(), 0, n*sizeof(ggml_fp16_t));
+            ggml_fp16_to_fp32_row(half.data(), values.data(), n);
+        }
+        for (float value : values) if (!std::isfinite(value)) throw std::runtime_error("nonfinite adapter tensor: " + name);
+        pairs[weight] = {a, b, alpha / rank};
+    }
+    if (pairs.empty()) throw std::runtime_error("empty LoRA adapter");
+}
+}
