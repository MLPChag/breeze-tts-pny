diff --git a/src/model.cpp b/src/model.cpp
index 8351e2d..933f47b 100644
--- a/src/model.cpp
+++ b/src/model.cpp
@@ -1,4 +1,6 @@
 #include "breeze/model.h"
+#include <regex>
+#include <stdexcept>
 
 namespace breeze {
 
@@ -10,7 +12,29 @@ bool BreezeModel::load(const std::string & path, bool prefer_gpu) {
     return true;
 }
 
+void BreezeModel::load_lora(const std::string & id, const std::string & path) {
+    if (!std::regex_match(id, std::regex("[A-Za-z0-9_-]{1,64}")) || adapters.count(id))
+        throw std::runtime_error("invalid or duplicate adapter id: " + id);
+    auto adapter = std::make_unique<LoRAAdapter>();
+    adapter->load(path, backend, gg);
+    adapters.emplace(id, std::move(adapter));
+}
+void BreezeModel::select_lora(const std::string & id) {
+    if (!has_lora(id)) throw std::runtime_error("unknown adapter: " + id);
+    active_lora = id.empty() ? nullptr : adapters.at(id).get();
+}
+ggml_tensor * BreezeModel::project(ggml_context * ctx, const std::string & name, ggml_tensor * x) const {
+    auto * out = linear(ctx, w(name), x);
+    if (!active_lora) return out;
+    const auto it = active_lora->pairs.find(name);
+    if (it == active_lora->pairs.end()) return out;
+    const auto & pair = it->second;
+    auto * delta = linear(ctx, pair.b, linear(ctx, pair.a, x));
+    return ggml_add(ctx, out, ggml_scale(ctx, delta, pair.scale));
+}
 void BreezeModel::free() {
+    active_lora = nullptr;
+    adapters.clear();
     gg.free();
     backend.free();
 }
